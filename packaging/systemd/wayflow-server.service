[Unit]
Description=Wayflow keyboard and mouse sharing server
Documentation=https://github.com/jmevatt/wayflow
# The XDG InputCapture portal lives on the user session bus, so this must
# run as a --user unit and start only once the graphical session is up.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wayflow server
Restart=on-failure
RestartSec=2
# Crash logs land in journalctl --user -u wayflow-server.

[Install]
WantedBy=graphical-session.target
