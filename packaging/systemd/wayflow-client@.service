[Unit]
Description=Wayflow client connecting to %i
Documentation=https://github.com/jmevatt/wayflow
# CGEvent (mac) / SendInput (windows) / XTest (linux non-wayland) all need
# a user graphical session, same as the server.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Instance template: %i is the server hostname or address. Enable as e.g.
#   systemctl --user enable --now wayflow-client@helicon.service
ExecStart=/usr/bin/wayflow client --server %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
